# Copy this file to .env.local and fill in the values
# .env.local is gitignored — never commit real keys

# Google Places API key (enables real nearby restaurants)
# Get it from: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Places API (legacy) or Places API (New)
VITE_GOOGLE_PLACES_KEY=

# Wolt affiliate ref code (appended to all "I'd order this" links)
# Apply at: https://wolt.com/en/business → Partners
# Or via Impact.com affiliate network (search "Wolt affiliate")
VITE_WOLT_REF=
